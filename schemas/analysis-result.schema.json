{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedha.local/schemas/analysis-result.schema.json",
  "title": "Vedha analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_type", "title", "summary", "visualizations", "evidence", "warnings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "output_type": { "enum": ["review-object", "live-canvas", "diagnosis-trace", "exception-route", "audit-trail"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "visualizations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "data"],
        "properties": {
          "type": { "enum": ["line", "bar", "funnel", "contribution-bar", "metric", "table"] },
          "title": { "type": "string" },
          "x": { "type": "string" },
          "y": { "type": "string" },
          "series": { "type": "string" },
          "data": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["result_id"],
        "properties": { "result_id": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
