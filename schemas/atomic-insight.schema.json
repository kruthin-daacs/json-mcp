{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedha.local/schemas/atomic-insight.schema.json",
  "title": "Vedha atomic insight",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "atom_id", "title", "sentence", "evidence_result_ids"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "atom_id": { "enum": ["A1", "A2", "A3", "A4", "D1", "E1", "E4", "E5", "G2", "H1"] },
    "title": { "type": "string", "minLength": 1 },
    "sentence": { "type": "string", "minLength": 1 },
    "evidence_result_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "value": { "type": "number" },
    "value_prior": { "type": "number" },
    "target": { "type": "number" },
    "unit": { "type": "string", "minLength": 1 },
    "display": { "type": "string", "minLength": 1 },
    "target_display": { "type": "string", "minLength": 1 },
    "status": { "enum": ["above_target", "below_target", "on_track", "no_target"] },
    "gap": { "type": "number" },
    "provisioned": { "type": "number", "minimum": 0 },
    "active": { "type": "number", "minimum": 0 },
    "value_per_entity": { "type": "number" },
    "prior_silent_share": { "type": "number", "minimum": 0, "maximum": 1 },
    "silent_count": { "type": "number", "minimum": 0 },
    "silent_share": { "type": "number", "minimum": 0, "maximum": 1 },
    "silent_value_at_risk": { "type": "number" },
    "silent_trend": { "enum": ["rising", "stable", "falling"] },
    "value_a": { "type": "number" },
    "value_b": { "type": "number" },
    "label_a": { "type": "string", "minLength": 1 },
    "label_b": { "type": "string", "minLength": 1 },
    "total": { "type": "number" },
    "members": { "type": "object", "minProperties": 2, "additionalProperties": { "type": "number" } },
    "parent": { "type": "number" },
    "parent_label": { "type": "string", "minLength": 1 },
    "children": { "type": "object", "minProperties": 2, "additionalProperties": { "type": "number" } },
    "children_prior": { "type": "object", "minProperties": 2, "additionalProperties": { "type": "number" } },
    "operator": { "enum": ["+", "×", "÷"] },
    "change_bridge": { "type": "object", "minProperties": 2, "additionalProperties": { "type": "number" } },
    "dominant_driver": { "type": "string", "minLength": 1 },
    "stage_labels": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "stage_counts": { "type": "array", "minItems": 2, "items": { "type": "number", "minimum": 0 } },
    "outcome_delta": { "type": "number" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cause", "impact"],
        "properties": { "cause": { "type": "string", "minLength": 1 }, "impact": { "type": "number" } }
      }
    },
    "metric_tree": { "type": "object" },
    "decision_type": { "enum": ["OPTIMIZE", "INVEST", "REPRICE", "RETIRE", "ESCALATE", "WATCH"] },
    "root_cause": { "type": "string", "minLength": 1 },
    "epistemic": { "enum": ["confirmed", "candidate"] }
  },
  "allOf": [
    { "if": { "properties": { "atom_id": { "const": "A1" } } }, "then": { "required": ["value", "unit", "display"] } },
    { "if": { "properties": { "atom_id": { "const": "A2" } } }, "then": { "required": ["value", "target", "unit", "display", "target_display", "status", "gap"] } },
    { "if": { "properties": { "atom_id": { "const": "A3" } } }, "then": { "required": ["value", "value_prior", "unit", "display"] } },
    { "if": { "properties": { "atom_id": { "const": "A4" } } }, "then": { "required": ["provisioned", "active", "value_per_entity", "prior_silent_share", "silent_count", "silent_share", "silent_value_at_risk", "silent_trend", "unit"] } },
    { "if": { "properties": { "atom_id": { "const": "D1" } } }, "then": { "required": ["value_a", "value_b", "label_a", "label_b", "unit"] } },
    { "if": { "properties": { "atom_id": { "const": "E1" } } }, "then": { "required": ["total", "members", "unit"] } },
    { "if": { "properties": { "atom_id": { "const": "E4" } } }, "then": { "required": ["parent", "parent_label", "children", "operator", "unit"] } },
    { "if": { "properties": { "atom_id": { "const": "E5" } } }, "then": { "required": ["children", "children_prior", "operator", "change_bridge", "dominant_driver", "unit"] } },
    { "if": { "properties": { "atom_id": { "const": "H1" } } }, "then": { "required": ["stage_labels", "stage_counts"] } },
    { "if": { "properties": { "atom_id": { "const": "G2" } } }, "then": { "required": ["outcome_delta", "candidates", "metric_tree", "decision_type", "root_cause", "epistemic"] } }
  ]
}
